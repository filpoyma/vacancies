{
  "name": "telegram-vacancy-monitor",
  "version": "0.1.0",
  "description": "MTProto-based Telegram vacancy monitoring worker",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "LOG_PRETTY=true node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "telegram:login": "LOG_PRETTY=true node src/cli/login.ts",
    "telegram:dialogs": "LOG_PRETTY=true node src/cli/dialogs.ts",
    "telegram:sources": "LOG_PRETTY=true node src/cli/configureSources.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "teleproto": "^1.229.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.4",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3"
  }
}
