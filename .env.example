TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MONGODB_URI=

# OpenRouter (optional — without key, rule-based parser/matcher is used)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Gmail SMTP for email applications (optional — App Password from Google Account)
GMAIL_USER=filpoyma@gmail.com
GMAIL_APP_PASSWORD=

# Apply sending toggles (true/false). When false, no outbound applications on that channel.
TELEGRAM_SEND_ENABLE=true
EMAIL_SEND_ENABLE=true

# Optional overrides for `pnpm apply:smoke` (defaults: @Romantra, poymaza@gmail.com)
# APPLY_SMOKE_TELEGRAM=@Romantra
# APPLY_SMOKE_EMAIL=poymaza@gmail.com

# Logging (optional): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Human-readable logs locally; omit or false for JSON (e.g. production)
# LOG_PRETTY=true
